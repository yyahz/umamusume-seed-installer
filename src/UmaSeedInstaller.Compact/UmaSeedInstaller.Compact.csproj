<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>种马搜索器安装助手-Compact</AssemblyName>
    <RootNamespace>UmaSeedInstaller.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\UmaSeedInstaller.App\Assets\app.ico</ApplicationIcon>
    <Version>0.1.8</Version>
    <Authors>Songe</Authors>
    <Product>种马搜索器安装更新助手 Compact</Product>
    <Description>使用 Windows 内置 .NET Framework 的轻量种马搜索器安装更新助手。</Description>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Compile Include="..\UmaSeedInstaller.App\MainForm.cs" Link="MainForm.cs" />
    <EmbeddedResource Include="..\UmaSeedInstaller.App\Assets\icon-128.png" Link="Assets\icon-128.png" />
  </ItemGroup>
</Project>
